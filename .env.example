SITE_URL=https://www.kontorkompass.de
# Supabase Postgres (West EU / Ireland) via the transaction pooler, port 6543:
# postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Leave empty to use the local SQLite file instead.
DATABASE_URL=
PAYLOAD_SECRET=change-me-long-random-string
# Newsletter (Resend, double opt-in)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Verifizierter Absender für die Bestätigungsmail (Domain kontorkompass.de bei Resend verifizieren), z. B. "Kontorkompass <redaktion@kontorkompass.de>"
NEWSLETTER_FROM=
# Langer Zufallsstring zum Signieren der Bestätigungslinks
NEWSLETTER_SECRET=
# Show internal review notes inside articles (never in production)
SHOW_EDITORIAL_NOTES=0
